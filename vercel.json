{
  "redirects": [
    {
      "source": "/downloads/:path*",
      "destination": "https://files.designoraa.in/downloads/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.designoraa.in" }],
      "destination": "https://designoraa.in/:path",
      "statusCode": 301
    }
  ]
}
